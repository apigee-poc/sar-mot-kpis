<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Extracts the records array of the integration output (D26) into kpi.records for
  debug sessions and logging. The 200 body does NOT use this variable: the array is
  parsed, validated and re-serialised by JS-ValidateIntegrationOutput (kpi.recordsJson),
  so the response does not depend on how ExtractVariables renders a JSON array.
  continueOnError is true: a non-JSON body must not fault here (that would become a 500);
  JS-ValidateIntegrationOutput + RF-BadGateway turn it into 502 ERR-502-GATEWAY.
-->
<ExtractVariables continueOnError="true" enabled="true" name="EV-ExtractIntegrationOutput">
  <DisplayName>EV-ExtractIntegrationOutput</DisplayName>
  <Source>response</Source>
  <VariablePrefix>kpi</VariablePrefix>
  <JSONPayload>
    <Variable name="records">
      <JSONPath>$.outputParameters.data.records</JSONPath>
    </Variable>
  </JSONPayload>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
