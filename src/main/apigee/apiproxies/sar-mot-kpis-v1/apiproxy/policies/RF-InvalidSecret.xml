<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-InvalidSecret">
  <DisplayName>RF-InvalidSecret</DisplayName>
  <!-- ERROR-CATALOG row 4: X-API-Secret missing or not the app's client secret (D8).
       No payload here: the DefaultFaultRule builds the error envelope. -->
  <FaultResponse>
    <AssignVariable>
      <Name>custom.errorCode</Name>
      <Value>ERR-401-SECRET</Value>
    </AssignVariable>
    <AssignVariable>
      <Name>custom.proxyFault</Name>
      <Value>true</Value>
    </AssignVariable>
    <Set>
      <StatusCode>401</StatusCode>
      <ReasonPhrase>Unauthorized</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
