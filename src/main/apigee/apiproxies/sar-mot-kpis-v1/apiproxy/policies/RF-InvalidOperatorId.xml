<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-InvalidOperatorId">
  <DisplayName>RF-InvalidOperatorId</DisplayName>
  <!-- ERROR-CATALOG row 9: X-Operator-Id missing or not a 10-digit National ID / Iqama number.
       No payload here: the DefaultFaultRule builds the error envelope. -->
  <FaultResponse>
    <AssignVariable>
      <Name>custom.errorCode</Name>
      <Value>ERR-400-OPERATOR</Value>
    </AssignVariable>
    <Set>
      <StatusCode>400</StatusCode>
      <ReasonPhrase>Bad Request</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
