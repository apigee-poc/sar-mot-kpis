<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-InvalidRequestId">
  <DisplayName>RF-InvalidRequestId</DisplayName>
  <!-- ERROR-CATALOG row 1: X-Request-Id missing or not a UUID.
       No payload here: the DefaultFaultRule builds the error envelope. -->
  <FaultResponse>
    <AssignVariable>
      <Name>custom.errorCode</Name>
      <Value>ERR-400-REQUESTID</Value>
    </AssignVariable>
    <AssignVariable>
      <Name>custom.proxyFault</Name>
      <Value>true</Value>
    </AssignVariable>
    <Set>
      <StatusCode>400</StatusCode>
      <ReasonPhrase>Bad Request</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
