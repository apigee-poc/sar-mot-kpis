<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SetLookupKey">
  <DisplayName>AM-SetLookupKey</DisplayName>
  <!-- Priority: custom.errorCode > fault.name > ERR-SYS-500 -->
  <AssignVariable>
    <Name>custom.errorLookupKey</Name>
    <Template>{firstnonnull(custom.errorCode,fault.name,'ERR-SYS-500')}</Template>
  </AssignVariable>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
