<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-IntegrationError">
  <DisplayName>RF-IntegrationError</DisplayName>
  <!-- ERROR-CATALOG row 13: the integration returned a non-2xx status.
       No payload here: the DefaultFaultRule builds the error envelope. -->
  <FaultResponse>
    <AssignVariable>
      <Name>custom.errorCode</Name>
      <Value>ERR-500-INTEGRATION</Value>
    </AssignVariable>
    <AssignVariable>
      <Name>custom.proxyFault</Name>
      <Value>true</Value>
    </AssignVariable>
    <AssignVariable>
      <Name>custom.statusOverride</Name>
      <Value>500</Value>
    </AssignVariable>
    <Set>
      <StatusCode>500</StatusCode>
      <ReasonPhrase>Internal Server Error</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
