<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy name="sar-mot-kpis-v1">
  <DisplayName>sar-mot-kpis-v1</DisplayName>
  <Description>SAR MOT KPI Data Sharing POC API Proxy</Description>
  <BasePaths>/mot-kpis/business-domain/v1</BasePaths>
  <Policies>
    <Policy>AM-BuildErrorResponse</Policy>
    <Policy>AM-BuildKpiResponse</Policy>
    <Policy>AM-CheckErrorMessage</Policy>
    <Policy>AM-SetClientTraceId</Policy>
    <Policy>AM-SetIntegrationCalled</Policy>
    <Policy>AM-SetIntegrationError</Policy>
    <Policy>AM-SetKpiCode</Policy>
    <Policy>AM-SetLookupKey</Policy>
    <Policy>AM-SetQuotaValues</Policy>
    <Policy>AM-SetRateIdentifier</Policy>
    <Policy>AM-SetResponseRequestIdHeader</Policy>
    <Policy>AM-SetStatus403</Policy>
    <Policy>AM-SetStatus429</Policy>
    <Policy>AM-SetSystemError</Policy>
    <Policy>AM-SetTimeoutError</Policy>
    <Policy>AM-SetTraceAndTimestamp</Policy>
    <Policy>EV-ExtractIntegrationOutput</Policy>
    <Policy>JS-CheckKpiAllowed</Policy>
    <Policy>JS-SetIntegrationParams</Policy>
    <Policy>JS-ValidateApiSecret</Policy>
    <Policy>JS-ValidateIntegrationOutput</Policy>
    <Policy>JS-ValidateRequestInputs</Policy>
    <Policy>JS-ValidateRequestTimestamp</Policy>
    <Policy>KVM-GetConfig</Policy>
    <Policy>KVM-GetErrorMessage</Policy>
    <Policy>Q-ImposeQuota</Policy>
    <Policy>RF-BadGateway</Policy>
    <Policy>RF-IntegrationError</Policy>
    <Policy>RF-InvalidOperatorId</Policy>
    <Policy>RF-InvalidQueryParams</Policy>
    <Policy>RF-InvalidRequestId</Policy>
    <Policy>RF-InvalidRequestTimestamp</Policy>
    <Policy>RF-InvalidSecret</Policy>
    <Policy>RF-MethodNotAllowed</Policy>
    <Policy>RF-ResourceNotFound</Policy>
    <Policy>SA-SpikeArrest</Policy>
    <Policy>SIR-SetIntegrationRequest</Policy>
    <Policy>VA-VerifyApiKey</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <IntegrationEndpoints>
    <IntegrationEndpoint>default</IntegrationEndpoint>
  </IntegrationEndpoints>
  <Resources>
    <Resource>jsc://checkKpiAllowed.js</Resource>
    <Resource>jsc://setIntegrationParams.js</Resource>
    <Resource>jsc://validateApiSecret.js</Resource>
    <Resource>jsc://validateIntegrationOutput.js</Resource>
    <Resource>jsc://validateRequestInputs.js</Resource>
    <Resource>jsc://validateRequestTimestamp.js</Resource>
  </Resources>
  <TargetEndpoints/>
</APIProxy>
