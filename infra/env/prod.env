# Prod environment configuration (env prod, Apigee org apigee-prod-511508). No secrets.
# Used ONLY by cloudbuild-infra-prod.yaml / cloudbuild-prod.yaml (TARGET=prod, inside Cloud Build):
# infra/lib/guard.sh refuses this file anywhere else (AGENTS.md rule 2).
# Every key of nonprod.env is defined here so infra/01-04 and db/load.sh run unchanged.
# Project and Region
PROJECT_ID="apigee-prod-511508"
REGION="us-central1"
CI_CD_PROJECT_ID="ci-cd-511313"

# Service Accounts (runtime SAs live in the prod project)
PROXY_RUNTIME_SA="sa-kpi-proxy-runtime"
CONNECTOR_SA="sa-kpi-connector"
CB_DEPLOY_SA="cb-deploy-prod@ci-cd-511313.iam.gserviceaccount.com"

# Cloud SQL & Databases
SQL_INSTANCE="sar-kpi-sql-prod"
# Smallest dedicated-core tier (1 vCPU, 3.75 GB): no shared-core in prod, still small for a POC.
SQL_TIER="db-custom-1-3840"
SQL_VERSION="POSTGRES_15"
# Prod has one database. DB_DEV/DB_STAGING are kept (empty) so the key set mirrors nonprod.env;
# infra/03 skips empty names. Never point them at kpis_dev/kpis_staging here.
DB_DEV=""
DB_STAGING=""
DB_PROD="kpis_prod"
DB_USER="kpi_reader"
DB_SECRET_NAME="sar-kpi-db-reader-password"
SEED_BUCKET="apigee-prod-511508-sar-kpi-seed"

# PSC & Connections
PSC_ENDPOINT_ATTACHMENT="sar-kpi-sql-prod-ea"
CONNECTION_DEV=""
CONNECTION_STAGING=""
CONNECTION_PROD="sar-kpi-db-prod"

# Prod-only settings (absent from nonprod.env). infra/02 and infra/04 switch their prod-only steps
# on IS_PROD (set by infra/lib/guard.sh from PROJECT_ID), never on a variable of this file.
# infra/02 (prod): the build SA reads only the pipeline smoke-app secrets (never the MOT handover app's).
NEWMAN_SECRETS="sar-mot-smoke-app-api-key sar-mot-smoke-app-api-secret"

# infra/06 (prod API product + apps)
APIGEE_ENV="prod"
# PLACEHOLDER: replace with the real MOT developer email before the first prod infra run.
MOT_DEVELOPER_EMAIL="${MOT_DEVELOPER_EMAIL:-mot-poc@example.com}"
SMOKE_DEVELOPER_EMAIL="sar-mot-smoke@example.com"
