{
  "description": "SAR MOT KPIs Cloud SQL PostgreSQL connection for staging",
  "connectorDetails": {
    "provider": "default",
    "name": "postgresql",
    "version": 1
  },
  "configVariables": [
    {
      "key": "database_name",
      "stringValue": "kpis_staging"
    }
  ],
  "authConfig": {
    "authType": "USER_PASSWORD",
    "userPassword": {
      "username": "kpi_reader",
      "password": {
