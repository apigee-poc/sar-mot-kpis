    "test:dev": "bash tests/run-newman.sh dev",
    "test:staging": "bash tests/run-newman.sh staging",
    "package": "mvn -f src/main/apigee/apiproxies/sar-mot-kpis-v1/pom.xml clean package -Pdev"
  },
  "repository": {
