  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "lint": "apigeelint -s src/main/apigee/apiproxies/sar-mot-kpis-v1/apiproxy -f table.js --profile apigeex --maxWarnings 0",
