  },
  "homepage": "https://github.com/apigee-poc/sar-mot-kpis#readme",
  "devDependencies": {
    "apigeelint": "2.85.1",
    "chai": "^4.4.1",
    "mocha": "^10.8.2",
    "newman": "6.2.3"
  }
}
